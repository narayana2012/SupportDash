# supportdash environment template.
# Copy to .env (git-ignored) and edit locally: cp .env.example .env
# Placeholders only. Never put a real key, token, password, or connection string here.
# Settings are cached (get_settings()). Restart the backend after changing .env.
# Every variable in CLAUDE.md section 10.1 appears below.

# --- Runtime ---
DEMO_MODE=true
ENVIRONMENT=local
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Auth (HS256) ---
JWT_SECRET=change-me-local-only
SUPABASE_JWT_SECRET=

# --- Data stores ---
# Demo: sqlite+aiosqlite:///./data/support.db
# Cloud: postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite+aiosqlite:///./data/support.db
# ./data/checkpoints.db, or :memory: in tests
CHECKPOINT_DB_PATH=./data/checkpoints.db
# Empty means fakeredis. Otherwise redis://HOST:6379/0
REDIS_URL=
USE_FAKE_REDIS=true

# --- LLM and embeddings (offline by default) ---
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=384

# --- Vector store ---
VECTOR_STORE=memory
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=supportdash_knowledge

# --- Policy and limits ---
APPROVAL_REQUIRED_FOR_REFUNDS=true
MAX_REFUND_WITHOUT_APPROVAL=0
TOOL_TIMEOUT_SECONDS=10
RATE_LIMIT_PER_MINUTE=120
SAMPLE_DATA_DIR=./sample_data

# --- Observability (optional) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=supportdash-support
